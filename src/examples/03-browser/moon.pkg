// The glue the front plate runs: this program executes the library and leaves what it
// produced on `globalThis` for the page to draw.
//
// It is a JS-only package because its whole job is to reach the page: on any other
// target the FFI below has nowhere to write. The docs workflow builds it into
// `docs/engine/moonp8s.js`, which is a build product and not in the repository.
pkgtype(kind: "executable")

supported_targets = "js"

import {
  "moonbitstack/moonp8s/metric",
  "moonbitstack/moonp8s/expo",
}
